# Development defaults for uv-managed xpool commands.
#
# Use this file by copying it to a local .env, editing local-only values, and
# exporting UV_ENV_FILE before running uv commands:
#
#   export UV_ENV_FILE=/path/to/xpool/.env
#   uv run xpool daemon --check
#
# Keep the real .env untracked.

XPOOL_CONFIG=configs/xpool.example.toml

# SGLang loads xpool from the sglang.srt.plugins entry point group.
SGLANG_PLUGINS=xpool
