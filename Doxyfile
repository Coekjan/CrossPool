PROJECT_NAME           = xpool
PROJECT_BRIEF          = "C++/CUDA native header documentation gate for xpool"
OUTPUT_DIRECTORY       = build/doxygen

INPUT                  = src/cext-include
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.hh *.cuh
EXTENSION_MAPPING      = cu=C++ cuh=C++
PREDEFINED             = __CUDACC__=1 \
                         __device__= \
                         __host__= \
                         __global__= \
                         __forceinline__= \
                         __constant__=

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

QUIET                  = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
